# Optional. The app runs without Redis (in-memory store).
# Admin routes reject every call when ADMIN_RESET_KEY is unset.
ADMIN_RESET_KEY=
# Comma-separated issued credentials. Any other X-API-Key is ignored.
API_KEYS=
# Trusted proxy hops, counted from the right of x-forwarded-for. 0 ignores forwarding headers.
TRUSTED_PROXY_HOPS=0
# Development only. Ignored when NODE_ENV=production.
# Lets the dashboard simulator send a fake x-forwarded-for.
ALLOW_UNTRUSTED_FORWARDED=1
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
